# ==============================================================================
# การตั้งค่าระบบรับสมัครเรียนออนไลน์ - วิทยาลัยเทคนิคท่าหลวงซิเมนต์ไทยอนุสรณ์
# ==============================================================================

# โหมดฐานข้อมูล: "supabase" หรือ "local" (หากยังไม่ได้เชื่อม Supabase ให้ใช้ local ซึ่งจะทำงานได้ทันที)
DATA_PROVIDER=local

# การเชื่อมต่อ Supabase (หากมีโปรเจกต์ Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# การแจ้งเตือน LINE Messaging API / LINE Notify (เปิด/ปิดได้ในระบบ)
LINE_NOTIFY_TOKEN=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# การแจ้งเตือนอีเมล (Resend / SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=admission@thaluang.ac.th

# Admin Secret สำหรับการจำลอง Auth ในโหมด Local
ADMIN_DEFAULT_PASSWORD=admin1234
